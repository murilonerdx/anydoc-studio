# Normalize text files to LF; never touch binaries.
* text=auto eol=lf
# Binary assets — no EOL conversion, no textual diff.
*.wasm         binary
*.onnx         binary
*.traineddata  binary
*.gz           binary
*.woff2        binary
*.woff         binary
*.ttf          binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.pdf          binary
*.docx         binary
*.map          binary
vendor/onnxruntime-web/*.wasm filter=lfs diff=lfs merge=lfs -text
